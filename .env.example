# MongoDB Atlas connection string (from Atlas → Connect → Drivers → Node.js)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name (change if you want)
MONGODB_DB=freshmart

# Long random string. Generate one: `openssl rand -hex 48`
JWT_SECRET=replace-with-long-random-string

# First-time admin bootstrap. On first login attempt with these creds,
# an admin record is created in Mongo with the password hashed.
# After that, you can rotate or remove these vars.
ADMIN_BOOTSTRAP_EMAIL=admin@freshmart.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeStrong#1
